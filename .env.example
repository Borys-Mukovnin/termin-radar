# Copy to .env for local runs, or add these as GitHub Actions secrets.
# At least one notification channel must be configured.

# ── E-mail (Gmail: use an App Password, not your account password) ───────────
SMTP_USER=you@gmail.com
SMTP_PASSWORD=abcd efgh ijkl mnop
ALERT_TO=you@gmail.com,partner@example.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# ── Telegram (optional, but the fastest way to actually notice an alert) ─────
# TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather
# TELEGRAM_CHAT_ID=123456789
